# Base URL of the Mboa Trust backend API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Firebase web app config — same project as MboaTrustFrontend/.env.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud Console → APIs & Services →
# Credentials). At least one must be set for the "Continue with Google"
# button to appear. iOS/Android need their own native OAuth client
# registered under the app's bundle id / package name + SHA-1 (Android);
# the web client id also covers Expo Go / `expo start --web`.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
